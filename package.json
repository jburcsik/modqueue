{
  "name": "modqueue",
  "version": "0.1.0",
  "description": "Moderation and anti-abuse kit: trust-weighted reports with decay, a reach coefficient, a consequence ladder with appeals, and an RLS-first Supabase schema",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.11"
  },
  "files": [
    "dist",
    "supabase/migrations"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./supabase": {
      "import": {
        "types": "./dist/supabase/index.d.mts",
        "default": "./dist/supabase/index.mjs"
      },
      "require": {
        "types": "./dist/supabase/index.d.cts",
        "default": "./dist/supabase/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "lint": "eslint . && tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:db": "supabase test db",
    "check:package": "npm run build && publint && attw --pack . && npm pack --dry-run"
  },
  "peerDependencies": {
    "@supabase/supabase-js": "^2.45.0"
  },
  "peerDependenciesMeta": {
    "@supabase/supabase-js": {
      "optional": true
    }
  },
  "dependencies": {
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^9.39.0",
    "@supabase/supabase-js": "^2.116.0",
    "@types/node": "^22.19.0",
    "eslint": "^9.39.0",
    "publint": "^0.3.25",
    "tsdown": "^0.23.7",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.48.0",
    "vitest": "^5.1.0"
  },
  "typesVersions": {
    "*": {
      "supabase": [
        "./dist/supabase/index.d.cts"
      ]
    }
  }
}
